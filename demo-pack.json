  "questions": [
    {
      "id": "d1",
      "original": "解方程：$3(x-2)=2x+1$",
      "knowledgePoints": ["一元一次方程"],
      "difficulty": 2,
      "timeLimitSec": 120,
      "steps": [
        {
          "prompt": "第一步先去括号：$3(x-2)$ 展开后等于多少？",
          "type": "choice",
          "options": ["$3x-6$", "$3x-2$", "$x-6$", "$3x+6$"],
          "answer": "A",
          "hint": "括号外的 $3$ 要分别乘括号里的每一项，别漏了 $-2$ 哦。",
          "explanation": "$3(x-2)=3\\cdot x-3\\cdot 2=3x-6$，方程变为 $3x-6=2x+1$。"
        },
        {
          "prompt": "移项：把含 $x$ 的项移到左边，常数项移到右边，得到 $3x-2x=1+\\square$。方框里填多少？",
          "type": "number",
          "answer": "6",
          "hint": "$-6$ 从左边移到右边要变号。",
          "explanation": "移项要变号：$-6$ 移到右边变成 $+6$，所以 $3x-2x=1+6$。"
        },
        {
          "prompt": "合并同类项，求出 $x=$ ？",
          "type": "number",
          "answer": "7",
          "hint": "左边 $3x-2x=x$，右边 $1+6=?$",
          "explanation": "合并得 $x=7$。可以代回检验：左边 $3\\times(7-2)=15$，右边 $2\\times7+1=15$ ✔"
        }
      ],
      "finalAnswer": "$x=7$",
      "formulas": [
        {"name": "去括号法则", "latex": "a(b+c)=ab+ac", "tip": "括号前是负号时，括号里每一项都要变号。"},
        {"name": "移项变号", "latex": "x+a=b \\Rightarrow x=b-a", "tip": "从等号一边移到另一边，符号要改变。"}
      ],
      "method": "解一元一次方程的五步：去分母 → 去括号 → 移项 → 合并同类项 → 系数化为 1。最后记得代回原方程检验。"
    },
    {
      "id": "d2",
      "original": "计算：$-2^2+(-3)\\times\\left(-\\dfrac{1}{3}\\right)-|-5|$",
      "knowledgePoints": ["有理数运算", "绝对值"],
      "difficulty": 2,
      "timeLimitSec": 150,
      "steps": [
        {
          "prompt": "先算乘方：$-2^2=$ ？",
          "type": "number",
          "answer": "-4",
          "hint": "注意：$-2^2$ 表示“$2^2$ 的相反数”，负号不参与乘方；它和 $(-2)^2$ 不一样。",
          "explanation": "$-2^2=-(2\\times2)=-4$，而 $(-2)^2=4$，这是常考易错点！"
        },
        {
          "prompt": "再算乘法：$(-3)\\times\\left(-\\dfrac{1}{3}\\right)=$ ？",
          "type": "number",
          "answer": "1",
          "hint": "负负得正，$3$ 和 $\\dfrac13$ 互为倒数。",
          "explanation": "同号相乘得正，$3\\times\\dfrac13=1$，所以结果是 $1$。"
        },
        {
          "prompt": "绝对值：$|-5|=$ ？",
          "type": "number",
          "answer": "5",
          "hint": "负数的绝对值是它的相反数。",
          "explanation": "$|-5|=5$。"
        },
        {
          "prompt": "最后合起来：$-4+1-5=$ ？",
          "type": "number",
          "answer": "-8",
          "hint": "从左到右依次计算：$-4+1=-3$，再减 $5$。",
          "explanation": "$-4+1-5=-3-5=-8$。"
        }
      ],
      "finalAnswer": "$-8$",
      "formulas": [
        {"name": "运算顺序", "latex": "\\text{乘方} \\to \\text{乘除} \\to \\text{加减}", "tip": "有括号先算括号里的；同级运算从左到右。"},
        {"name": "绝对值", "latex": "|a|=\\begin{cases}a,&a\\ge0\\\\-a,&a<0\\end{cases}", "tip": "绝对值一定是非负数。"}
      ],
      "method": "有理数混合运算：先确定运算顺序（乘方→乘除→加减），每一步先定符号再算数值。特别注意 $-a^n$ 与 $(-a)^n$ 的区别。"
    },
    {
      "id": "d3",
      "original": "在 $\\mathrm{Rt}\\triangle ABC$ 中，$\\angle C=90^\\circ$，两条直角边 $AC=6$，$BC=8$。求斜边 $AB$ 上的高 $CD$ 的长。",
      "knowledgePoints": ["勾股定理", "三角形面积"],
      "difficulty": 3,
      "timeLimitSec": 180,
      "steps": [
        {
          "prompt": "先用勾股定理求斜边：$AB=$ ？",
          "type": "number",
          "answer": "10",
          "hint": "$AB^2=AC^2+BC^2=36+64$。",
          "explanation": "$AB=\\sqrt{6^2+8^2}=\\sqrt{100}=10$。（$6,8,10$ 是常见勾股数）"
        },
        {
          "prompt": "用两条直角边求 $\\triangle ABC$ 的面积：$S=$ ？",
          "type": "number",
          "answer": "24",
          "hint": "直角三角形面积 = 两直角边乘积的一半。",
          "explanation": "$S=\\dfrac12\\times6\\times8=24$。"
        },
        {
          "prompt": "同一个三角形的面积也等于 $\\dfrac12\\times AB\\times CD$。所以 $CD=$ ？（可填小数或分数）",
          "type": "number",
          "answer": "4.8",
          "acceptable": ["24/5"],
          "hint": "$\\dfrac12\\times10\\times CD=24$，解这个方程。",
          "explanation": "$CD=\\dfrac{2S}{AB}=\\dfrac{48}{10}=4.8$。这就是“等面积法”。"
        }
      ],
      "finalAnswer": "$CD=4.8$",
      "formulas": [
        {"name": "勾股定理", "latex": "a^2+b^2=c^2", "tip": "只适用于直角三角形，$c$ 是斜边。"},
        {"name": "直角三角形斜边上的高", "latex": "h=\\dfrac{ab}{c}", "tip": "等面积法：两直角边之积 = 斜边 × 斜边上的高。"}
      ],
      "method": "先用勾股定理求斜边，再用“等面积法”：同一个三角形用两种底和高表示面积，列等式求高。"
    },
    {
      "id": "d4",
      "original": "已知一次函数 $y=kx+b$ 的图像经过点 $(1,3)$ 和 $(-1,-1)$。(1) 求这个一次函数的解析式；(2) 求它的图像与 $x$ 轴交点的坐标。",
      "knowledgePoints": ["一次函数", "二元一次方程组"],
      "difficulty": 4,
      "timeLimitSec": 240,
      "steps": [
        {
          "prompt": "把两个点代入 $y=kx+b$，得到的方程组是哪一个？",
          "type": "choice",
          "options": ["$\\begin{cases}k+b=3\\\\-k+b=-1\\end{cases}$", "$\\begin{cases}k+b=3\\\\k-b=-1\\end{cases}$", "$\\begin{cases}3k+b=1\\\\-k+b=-1\\end{cases}$", "$\\begin{cases}k+3b=1\\\\-k-b=1\\end{cases}$"],
          "answer": "A",
          "hint": "点 $(1,3)$ 表示 $x=1$ 时 $y=3$，代入就是 $3=k\\cdot1+b$。",
          "explanation": "代入 $(1,3)$：$k+b=3$；代入 $(-1,-1)$：$-k+b=-1$。"
        },
        {
          "prompt": "两式相加消去 $k$，可以求出 $b=$ ？",
          "type": "number",
          "answer": "1",
          "hint": "相加得 $2b=2$。",
          "explanation": "$(k+b)+(-k+b)=3+(-1)$，即 $2b=2$，$b=1$。"
        },
        {
          "prompt": "把 $b=1$ 代回 $k+b=3$，得 $k=$ ？",
          "type": "number",
          "answer": "2",
          "hint": "$k=3-b$。",
          "explanation": "$k=3-1=2$，所以解析式为 $y=2x+1$。"
        },
        {
          "prompt": "图像与 $x$ 轴交点处 $y=0$。令 $2x+1=0$，交点的横坐标 $x=$ ？",
          "type": "number",
          "answer": "-1/2",
          "acceptable": ["-0.5"],
          "hint": "$2x=-1$，再两边同时除以 $2$。",
          "explanation": "$x=-\\dfrac12$，所以交点坐标是 $\\left(-\\dfrac12,0\\right)$。"
        }
      ],
      "finalAnswer": "(1) $y=2x+1$；(2) $\\left(-\\dfrac12,0\\right)$",
      "formulas": [
        {"name": "待定系数法", "latex": "y=kx+b\\ (k\\ne0)", "tip": "两个点确定一条直线：代入两点，解方程组求 $k$、$b$。"},
        {"name": "与坐标轴交点", "latex": "x\\text{轴}: y=0;\\quad y\\text{轴}: x=0", "tip": "求与哪条轴的交点，就令另一个坐标为 0。"}
      ],
      "method": "待定系数法：设解析式 → 代入已知点 → 解方程组 → 写出解析式。求与 $x$ 轴交点就令 $y=0$。"
    },
    {
      "id": "d5",
      "original": "先化简，再求值：$(x+2)^2-(x+1)(x-1)$，其中 $x=-\\dfrac{1}{2}$。",
      "knowledgePoints": ["整式乘法", "乘法公式"],
      "difficulty": 3,
      "timeLimitSec": 200,
      "steps": [
        {
          "prompt": "用完全平方公式展开：$(x+2)^2=$ ？",
          "type": "choice",
          "options": ["$x^2+4x+4$", "$x^2+4$", "$x^2+2x+4$", "$x^2+4x+2$"],
          "answer": "A",
          "hint": "$(a+b)^2=a^2+2ab+b^2$，中间项是 $2\\cdot x\\cdot 2$。",
          "explanation": "$(x+2)^2=x^2+2\\cdot x\\cdot2+2^2=x^2+4x+4$。千万别漏掉中间项！"
        },
        {
          "prompt": "用平方差公式：$(x+1)(x-1)=$ ？（例如输入 x^2-1 或 x²-1）",
          "type": "text",
          "answer": "x^2-1",
          "acceptable": ["-1+x^2"],
          "hint": "$(a+b)(a-b)=a^2-b^2$。",
          "explanation": "$(x+1)(x-1)=x^2-1^2=x^2-1$。"
        },
        {
          "prompt": "相减并化简：$(x^2+4x+4)-(x^2-1)=$ ？",
          "type": "text",
          "answer": "4x+5",
          "acceptable": ["5+4x"],
          "hint": "去括号时，减号后面的括号里每一项都要变号：$-(x^2-1)=-x^2+1$。",
          "explanation": "$x^2+4x+4-x^2+1=4x+5$。"
        },
        {
          "prompt": "代入 $x=-\\dfrac12$，求值：$4x+5=$ ？",
          "type": "number",
          "answer": "3",
          "hint": "$4\\times\\left(-\\dfrac12\\right)=-2$。",
          "explanation": "$4\\times\\left(-\\dfrac12\\right)+5=-2+5=3$。"
        }
      ],
      "finalAnswer": "化简得 $4x+5$，当 $x=-\\dfrac12$ 时，原式 $=3$",
      "formulas": [
        {"name": "完全平方公式", "latex": "(a\\pm b)^2=a^2\\pm2ab+b^2", "tip": "口诀：首平方，尾平方，二倍乘积放中央。"},
        {"name": "平方差公式", "latex": "(a+b)(a-b)=a^2-b^2", "tip": "两数和乘两数差，等于它们的平方差。"}
      ],
      "method": "“先化简再求值”一定要先化简到最简形式再代入，计算量最小。展开时注意减号后面的括号要整体变号。"
    }
  ]
}
